# Normalize line endings for text sources; keep binaries untouched.
* text=auto eol=lf

*.kt        text eol=lf
*.kts       text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.properties text eol=lf

*.png       binary
*.jpg       binary
*.jpeg      binary
*.apk       binary
*.aab       binary
*.jks       binary
*.keystore  binary
